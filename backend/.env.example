# Server Settings
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql+asyncpg://nse:nse@localhost:5432/nse_analytics
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# JWT & Security
JWT_SECRET_KEY=change-me-in-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Background Workers
MARKET_POLL_INTERVAL_SECONDS=15
SECTOR_UPDATE_INTERVAL_SECONDS=60
NEWS_INGEST_INTERVAL_SECONDS=600
PORTFOLIO_SNAPSHOT_CRON=30 15 * * 1-5

# ML Settings
ML_PROCESS_POOL_SIZE=4
YFINANCE_CACHE_TTL_SECONDS=300
